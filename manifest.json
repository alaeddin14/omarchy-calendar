{
  "schemaVersion": 1,
  "id": "tmn73.calendar",
  "name": "Calendar",
  "version": "0.3.0",
  "author": "tmn73",
  "license": "MIT",
  "description": "Your Google Calendar in the bar. Your next meeting at a glance, and one click to join it.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Calendar",
    "description": "Your Google Calendar in the bar. Your next meeting at a glance, and one click to join it.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n-\nmm",
      "agendaView": false,
      "agendaCount": 10
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Date format",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "defaultValue": "d MMMM 'W'ww yyyy"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical bar format",
        "defaultValue": "HH\n-\nmm"
      },
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "defaultValue": 0
      },
      {
        "key": "lifeExpectancy",
        "type": "number",
        "label": "Life expectancy",
        "defaultValue": 0
      },
      {
        "key": "agendaView",
        "type": "boolean",
        "label": "Agenda view",
        "defaultValue": false,
        "description": "List what is coming up instead of the day selected in the grid."
      },
      {
        "key": "agendaCount",
        "type": "integer",
        "label": "Events in the agenda",
        "min": 3,
        "max": 50,
        "step": 1,
        "defaultValue": 10,
        "description": "Today is always shown in full, even when it runs over this."
      }
    ]
  }
}
